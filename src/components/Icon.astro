---
/** Inline line icons (24 × 24, drawn with currentColor). Add new ones to the map. */
const icons = {
  'arrow-up': '<path d="M12 19V5M6 11l6-6 6 6"/>',
  contrast: '<circle cx="12" cy="12" r="8.25"/><path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 9h16M4 15h16"/>',
  mail: '<rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2.25"/><path d="m4 7 8 6 8-6"/>',
  linkedin: '<rect x="3.25" y="3.25" width="17.5" height="17.5" rx="3.5"/><path d="M8 10.5v6M8 7.6v.01M11.75 16.5v-6M11.75 13.25c0-1.6 1-2.75 2.4-2.75s2.1 1 2.1 2.6v3.4"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
