---
import Icon from './Icon.astro';
import { contact, person } from '../data/profile';
---

<footer class="footer">
  <div class="container inner">
    <div class="brand">
      <p class="name">{person.name}</p>
      <p class="sub">{person.headline}</p>
    </div>

    <div class="links">
      {contact.email && <a href={`mailto:${contact.email}`}>Email</a>}
      {
        contact.linkedin && (
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        )
      }
      <a class="top" href="#top" data-print="hide">
        Back to top
        <Icon name="arrow-up" size={15} />
      </a>
    </div>
  </div>
</footer>

<style>
  /* Parchment again, closing the page the way the introduction opens it. */
  .footer {
    margin-top: calc(var(--section-space) * 1.25);
    padding-block: 2.25rem 2.5rem;
    background: var(--paper-tint);
    border-top: 1px solid var(--gold);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--heading);
  }

  .sub {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media print {
    .footer {
      background: none;
    }
  }
</style>
